ANTHROPIC_API_KEY=your-key-here

# Comma-separated list of registry URLs (add more for redundancy)
REGISTRY_URLS=http://localhost:8000

# Timing controls — edit these to slow down / speed up the agents
# All values are in seconds unless the name says _minutes

# Player: how long to wait between bets (1 LLM call per bet)
BET_DELAY_SECONDS=60

# Player: how often to re-fetch casino game lists
DISCOVERY_INTERVAL_SECONDS=60

# Casino: how many minutes of silence before the casino considers redesigning its games
ADAPTATION_SILENCE_MINUTES=10

# Observer: how often to poll all agents for stats
POLL_INTERVAL_SECONDS=30
